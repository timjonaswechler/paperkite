[Unit]
Description=Bewerbungsverwaltung mit originalem T3 Code
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/redjoker/workspace/containers/bewerbung
ExecStart=/home/redjoker/.local/bin/node --import tsx server/main.ts
Environment=PATH=/home/redjoker/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=PUBLIC_ORIGIN=https://bewerbung.teejayslab.de
UMask=0077
Restart=on-failure
RestartSec=3
TimeoutStopSec=150
KillMode=mixed

[Install]
WantedBy=default.target
