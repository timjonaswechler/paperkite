[Unit]
Description=Unabhängige Bewerbungs-Webapp
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/redjoker/workspace/containers/bewerbung
ExecStart=/home/redjoker/.local/bin/node --import tsx server/main.ts
Environment=PATH=/home/redjoker/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=PORT=3119
UMask=0077
Restart=on-failure
RestartSec=3
TimeoutStopSec=150
MemoryMax=2G
TasksMax=256
NoNewPrivileges=yes

[Install]
WantedBy=default.target
