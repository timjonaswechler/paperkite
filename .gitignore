# Private runtime data and local working areas
/data/
/backups/
/.work/
/.frontend-captures/

# Installed dependencies and generated output
/node_modules/
/dist/
*.log

# Full pinned upstream source is tracked; native binaries and generated dependencies are not
/native-t3/runtime/
/native-t3/.runtime-*/
/vendor/t3/.git/
/vendor/t3/.repos/
/vendor/t3/node_modules/
/vendor/t3/apps/*/node_modules/
/vendor/t3/packages/*/node_modules/
/vendor/t3/apps/*/dist/
/vendor/*.tar
/vendor/*.tar.gz

# Local credentials and databases
.env
.env.*
!.env.example
*.sqlite
*.sqlite-*

# Local OS metadata
.DS_Store
